{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pettrip/scene-snapshot/v0.1",
  "title": "PetTrip session one SceneSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scene_id", "canvas", "layers", "activity_zone", "interactions", "build_slots"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "scene_id": {"const": "session1_beach"},
    "canvas": {
      "type": "object", "additionalProperties": false,
      "required": ["width", "height", "pixels_per_unit"],
      "properties": {
        "width": {"const": 512}, "height": {"const": 288},
        "pixels_per_unit": {"const": 16}
      }
    },
    "layers": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/layer"}},
    "activity_zone": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "points"],
      "properties": {
        "id": {"const": "beach_foreground"}, "type": {"const": "polygon"},
        "points": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/point"}}
      }
    },
    "interactions": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/interaction"}},
    "build_slots": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/buildSlot"}}
  },
  "$defs": {
    "point": {
      "type": "object", "additionalProperties": false, "required": ["x", "y"],
      "properties": {"x": {"type": "number", "minimum": 0, "maximum": 512}, "y": {"type": "number", "minimum": 0, "maximum": 288}}
    },
    "layer": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "asset_id", "sorting_order", "position"],
      "properties": {
        "id": {"type": "string"}, "asset_id": {"enum": ["beach_background", "lighthouse", "pet"]},
        "sorting_order": {"type": "integer"}, "position": {"$ref": "#/$defs/point"}
      }
    },
    "interaction": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "anchor", "radius"],
      "properties": {
        "id": {"const": "pet_wave"}, "kind": {"const": "pet_action"},
        "anchor": {"$ref": "#/$defs/point"}, "radius": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "buildSlot": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "position", "allowed_prefabs"],
      "properties": {
        "id": {"const": "small_shelter"}, "position": {"$ref": "#/$defs/point"},
        "allowed_prefabs": {"const": ["small_shelter"]}
      }
    }
  }
}
