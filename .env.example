# Copy the required names into a gitignored local env file.
# Never commit real API keys or private Provider URLs.

PILOT_API_KEY=<generate-outside-git>

CHAT_BASE_URL=https://<chat-provider>/v1
CHAT_API_KEY=<redacted>
CHAT_MODEL=<chat-model>

IMAGES_BASE_URL=https://<images-provider>/v1
IMAGES_API_KEY=<redacted>
IMAGES_MODEL=gpt-image-2

IMAGE_GENERATION_PATH=/images/generations
IMAGE_TIMEOUT=120
IMAGE_REQUEST_SIZE=1024x1024
IMAGE_CANVAS_WIDTH=1024
IMAGE_CANVAS_HEIGHT=1024
IMAGE_MAX_DECODED_BYTES=20971520
IMAGE_MAX_PIXELS=20000000
